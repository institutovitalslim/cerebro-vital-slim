:root {
  --bg: #120e07;
  --bg-elevated: #17120c;
  --bg-soft: rgba(27, 20, 14, 0.88);
  --surface: rgba(24, 18, 12, 0.78);
  --surface-strong: rgba(30, 22, 15, 0.92);
  --surface-soft: rgba(212, 168, 60, 0.08);
  --line: rgba(212, 168, 60, 0.16);
  --line-strong: rgba(212, 168, 60, 0.3);
  --text: #e0dddc;
  --text-soft: #bcb6af;
  --muted: #a89c90;
  --accent-hi: #FFF1A8;
  --accent-mid: #F7D86A;
  --accent: #D4A83C;
  --accent-deep: #8A5F18;
  --accent-shadow: #5C3A0E;
  --gold-gradient: linear-gradient(135deg, var(--accent-hi) 0%, var(--accent-mid) 34%, var(--accent) 68%, var(--accent-deep) 100%);
  --danger: #ff8d87;
  --success: #7fd0a5;
  --shadow: 0 28px 80px rgba(0, 0, 0, 0.42);
  --radius-xl: 30px;
  --radius-lg: 24px;
  --radius-md: 18px;
  --content-width: 1480px;
  /* escala de espacamento */
  --s-1: 4px; --s-2: 8px; --s-3: 12px; --s-4: 16px; --s-5: 20px; --s-6: 24px; --s-7: 32px; --s-8: 40px;
  /* raios + tipografia */
  --radius-sm: 16px; --radius-pill: 999px;
  --fs-xs: 0.72rem; --fs-sm: 0.82rem; --fs-md: 0.92rem; --fs-base: 1rem;
  /* cores de estado (rampa validada na /trafego) */
  --state-good: #2f9e63;
  --state-warn: #c9a227;
  --state-bad: #c0524d;
  --state-neutral: #6f6a61;
}

* { box-sizing: border-box; }
html { background: var(--bg); }
body {
  margin: 0;
  padding: 0;
  color: var(--text);
  font-family: var(--font-sans), Arial, Helvetica, sans-serif;
  background:
    radial-gradient(circle at top left, rgba(255, 241, 168, 0.12) 0, rgba(255, 241, 168, 0) 30%),
    radial-gradient(circle at 85% 18%, rgba(212, 168, 60, 0.14) 0, rgba(212, 168, 60, 0) 28%),
    radial-gradient(circle at 75% 82%, rgba(212, 168, 60, 0.12) 0, rgba(212, 168, 60, 0) 24%),
    linear-gradient(180deg, #161109 0%, #0f0c08 100%);
  min-height: 100vh;
}

a { color: inherit; text-decoration: none; }
button, input, select, textarea { font: inherit; }
img { max-width: 100%; display: block; }

.shell {
  display: grid;
  grid-template-columns: 320px 1fr;
  min-height: 100vh;
}

.sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding: 30px 22px 26px;
  display: flex;
  flex-direction: column;
  gap: 26px;
  border-right: 1px solid rgba(212, 168, 60, 0.12);
  background:
    linear-gradient(180deg, rgba(12, 10, 7, 0.96) 0%, rgba(18, 14, 7, 0.98) 100%);
}

.sidebarBackdrop {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 18% 12%, rgba(255, 241, 168, 0.08), transparent 28%),
    radial-gradient(circle at 80% 80%, rgba(212, 168, 60, 0.08), transparent 30%);
}

.sidebarTop,
.nav,
.sidebarFooter { position: relative; z-index: 1; }
.sidebarTop { display: grid; gap: 14px; }
.sidebarDescription { max-width: 24ch; }

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.28em;
  font-size: 11px;
  color: rgba(255, 241, 168, 0.76);
}

.brand,
.pageTitle,
.heroTitle,
.sectionTitle,
.formHeader h3,
.card h2,
.card h3,
.metricValue {
  font-family: var(--font-display), Georgia, serif;
}

.brand {
  margin: 0;
  font-size: 2.55rem;
  line-height: 0.94;
  letter-spacing: -0.04em;
  color: #f6efe7;
}

.muted {
  color: var(--muted);
  line-height: 1.68;
}

.sidebar .muted { color: #b6a896; }
.small { font-size: 0.81rem; }

.nav { display: grid; gap: 18px; }
.navGroup { display: grid; gap: 10px; }
.navGroupTitle { margin-left: 8px; opacity: 0.82; }
.navGroupLinks { display: grid; gap: 8px; }

.navLink {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 48px;
  padding: 12px 14px 12px 16px;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(255, 255, 255, 0.06);
  background: rgba(255, 255, 255, 0.02);
  color: #ece4db;
  transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
}

.navLink::before {
  content: '';
  position: absolute;
  inset: 1px auto 1px 1px;
  width: 3px;
  border-radius: var(--radius-pill);
  background: transparent;
  transition: background 180ms ease;
}

.navLink:hover {
  transform: translateX(2px);
  border-color: rgba(212, 168, 60, 0.24);
  background: rgba(255, 255, 255, 0.05);
}

.navLinkActive {
  border-color: rgba(212, 168, 60, 0.34);
  background: linear-gradient(135deg, rgba(212, 168, 60, 0.2) 0%, rgba(255, 255, 255, 0.05) 100%);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04), 0 18px 36px rgba(0, 0, 0, 0.2);
}

.navLinkActive::before { background: linear-gradient(180deg, var(--accent-hi), var(--accent)); }
.navLinkLabel { font-size: 0.93rem; line-height: 1.35; }

.sidebarFooter {
  margin-top: auto;
  display: grid;
  gap: 14px;
  padding: 18px;
  border-radius: var(--radius-lg);
  border: 1px solid rgba(212, 168, 60, 0.12);
  background: rgba(255, 255, 255, 0.025);
}

.badge {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  min-height: 30px;
  padding: 6px 12px;
  border-radius: var(--radius-pill);
  border: 1px solid rgba(212, 168, 60, 0.18);
  background: rgba(212, 168, 60, 0.12);
  color: #f8e8c2;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.badgeDark {
  background: rgba(255, 255, 255, 0.04);
  color: #f4ece4;
  border-color: rgba(255, 255, 255, 0.08);
}

.content {
  position: relative;
  padding: 38px 38px 72px;
}

.content::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.02), transparent 16%),
    radial-gradient(circle at 80% 10%, rgba(255, 241, 168, 0.06), transparent 22%);
}

.content > * {
  position: relative;
  z-index: 1;
  max-width: var(--content-width);
  margin: 0 auto;
}

.dashboardRoot,
.section,
.pageHeader,
.heroMain,
.heroRail,
.metricGrid,
.grid,
.tableLike,
.formCard,
.featurePanel,
.recentGrid,
.splitSection,
.flowRail,
.flowCard,
.commandNext { display: grid; }

.dashboardRoot { gap: var(--s-7); }
.pageHeader { gap: var(--s-3); margin-bottom: var(--s-7); }
.heroHeader {
  padding: 30px;
  border-radius: var(--radius-xl);
  border: 1px solid var(--line);
  background:
    linear-gradient(135deg, rgba(33, 25, 17, 0.88) 0%, rgba(21, 16, 11, 0.92) 100%);
  box-shadow: var(--shadow);
}

.pageTitle,
.heroTitle {
  margin: 0;
  letter-spacing: -0.04em;
  color: #fff8ef;
}

.pageTitle { font-size: clamp(2.1rem, 3vw, 3.2rem); line-height: 1.02; }
.heroTitle { font-size: clamp(2.8rem, 5vw, 4.6rem); line-height: 0.95; max-width: 12ch; }
.heroText { font-size: 1.02rem; color: var(--text-soft); max-width: 64ch; margin: 0; }

.heroSurface {
  grid-template-columns: minmax(0, 1.55fr) minmax(320px, 0.78fr);
  gap: 22px;
  padding: 30px;
  border-radius: var(--radius-xl);
  border: 1px solid var(--line);
  background:
    linear-gradient(135deg, rgba(30, 22, 15, 0.9) 0%, rgba(20, 15, 10, 0.94) 100%);
  box-shadow: var(--shadow);
}

.commandHero {
  background:
    radial-gradient(circle at 18% 18%, rgba(255,241,168,0.12), transparent 30%),
    linear-gradient(135deg, rgba(37, 27, 18, 0.94) 0%, rgba(12, 10, 7, 0.98) 100%);
}

.commandNext {
  gap: 8px;
  max-width: 780px;
  padding: 18px;
  border-radius: var(--radius-lg);
  border: 1px solid rgba(255,241,168,0.22);
  background: rgba(255,255,255,0.035);
}
.commandNext strong { color: #fff5e8; font-size: 1.02rem; line-height: 1.45; }

.flowRail {
  grid-template-columns: repeat(4, minmax(220px, 1fr));
  gap: 16px;
}
.flowCard {
  gap: 14px;
  min-height: 300px;
  padding: 22px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--line);
  background:
    linear-gradient(180deg, rgba(31, 23, 15, 0.88), rgba(18, 14, 9, 0.92));
  box-shadow: var(--shadow);
}
.flowCard h3 { margin: 0; font-family: var(--font-display), Georgia, serif; font-size: 1.45rem; color: #fff5e8; letter-spacing: -0.03em; }
.flowCard .secondaryLink { margin-top: auto; }

.hookStack {
  display: grid;
  gap: 8px;
  padding: 14px;
  border-radius: var(--radius-md);
  border: 1px solid rgba(255, 241, 168, 0.16);
  background: rgba(255, 255, 255, 0.035);
}
.hookOption {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 8px;
  align-items: start;
  margin: 0;
  color: #e7d9c7;
  font-size: 0.82rem;
  line-height: 1.52;
  cursor: pointer;
}
.hookOption input { margin-top: 3px; accent-color: var(--accent-hi); }
.hookOption strong { color: var(--accent-hi); }

.heroMain { gap: 18px; }
.heroActions { display: flex; gap: 12px; flex-wrap: wrap; }
.heroRail { gap: 14px; }
.heroCallout,
.heroMetricCard,
.metricCard,
.featurePanel,
.card,
.formCard,
.row,
.empty,
.resultBox {
  background: var(--surface);
  border: 1px solid var(--line);
  box-shadow: var(--shadow);
  backdrop-filter: blur(12px);
}

.heroCallout,
.heroMetricCard,
.metricCard,
.featurePanel,
.card,
.formCard,
.row,
.empty { border-radius: var(--radius-lg); }

.heroCallout {
  margin-top: 8px;
  display: inline-grid;
  gap: 8px;
  width: fit-content;
  padding: 16px 18px;
}

.heroMetricCard,
.metricCard,
.featurePanel,
.card,
.formCard,
.row { padding: var(--s-6); }
.heroMetricCard { gap: 10px; }
.metricLabel,
.kicker {
  text-transform: uppercase;
  letter-spacing: 0.22em;
  font-size: 0.7rem;
  color: rgba(255, 241, 168, 0.82);
  font-weight: 700;
}
.metricValue { font-size: clamp(1.9rem, 3vw, 3rem); letter-spacing: -0.04em; color: #fff5e8; }

.primaryButton,
.primaryLink,
.secondaryLink {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: fit-content;
  min-height: 46px;
  border-radius: var(--radius-pill);
  padding: 0 18px;
  font-size: 0.9rem;
  font-weight: 700;
  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease, background 180ms ease;
}

.primaryButton,
.primaryLink {
  border: 1px solid rgba(255, 241, 168, 0.25);
  background: linear-gradient(180deg, rgba(212, 168, 60, 0.22) 0%, rgba(138, 110, 60, 0.24) 100%);
  color: #fff2d5;
  cursor: pointer;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
}

.secondaryLink {
  border: 1px solid var(--line-strong);
  background: rgba(255,255,255,0.03);
  color: #f0e7dd;
}

.primaryButton:hover,
.primaryLink:hover,
.secondaryLink:hover {
  transform: translateY(-1px);
  box-shadow: 0 12px 30px rgba(0,0,0,0.24);
}

.primaryButton:disabled {
  opacity: 0.7;
  cursor: wait;
}

.section { gap: var(--s-5); }
.sectionHeaderInline { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; }
.sectionTitle { margin: 0; font-size: clamp(1.6rem, 2.6vw, 2.4rem); letter-spacing: -0.03em; color: #fff5e8; }

.metricGrid { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--s-4); }
.splitSection,
.recentGrid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; }
.featurePanel { gap: 14px; }
.featurePanelDark {
  background: linear-gradient(180deg, rgba(35, 26, 17, 0.94) 0%, rgba(21, 16, 10, 0.94) 100%);
  color: #f8f1e7;
}
.featurePanelDark .eyebrow { color: rgba(255, 241, 168, 0.72); }
.featurePanelDark .muted { color: #d3c2b0; }
.checkGrid { gap: 10px; }
.checkRow { display: flex; align-items: center; gap: 10px; color: inherit; }
.checkDot {
  width: 10px;
  height: 10px;
  border-radius: var(--radius-pill);
  background: var(--accent-hi);
  box-shadow: 0 0 0 4px rgba(212, 168, 60, 0.14);
}

.grid { gap: var(--s-4); }
.tripleGrid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.formCard { gap: 12px; }
.formHeader h3 {
  margin: 0 0 6px;
  font-size: 1.8rem;
  letter-spacing: -0.03em;
  color: #fff5e8;
}
.card h3,
.card h2,
.card p { margin-top: 0; }
.cards { display: grid; gap: 16px; }

.input,
.textarea,
select.input {
  width: 100%;
  border: 1px solid rgba(212, 168, 60, 0.2);
  background: rgba(255, 255, 255, 0.04);
  border-radius: var(--radius-sm);
  padding: 14px 15px;
  color: var(--text);
}

.input::placeholder,
.textarea::placeholder { color: #8c8073; }

.input:focus,
.textarea:focus,
select.input:focus {
  outline: none;
  border-color: rgba(255, 241, 168, 0.4);
  box-shadow: 0 0 0 4px rgba(212, 168, 60, 0.12);
}

.textarea { resize: vertical; min-height: 120px; }
.successText { color: var(--success); font-size: 0.82rem; }
.errorText { color: var(--danger); font-size: 0.82rem; }
.resultBox {
  margin: 0;
  padding: 16px;
  border-radius: var(--radius-md);
  white-space: pre-wrap;
  font-size: 0.82rem;
  color: #ddd0c0;
  overflow: auto;
}
.briefingBox {
  display: grid;
  gap: 8px;
  border-color: rgba(255, 241, 168, 0.24);
  background: rgba(255, 241, 168, 0.055);
}
.briefingBox p { margin: 0; }

.tableLike { gap: 12px; }
.compactRows .row { gap: 8px; }
.row { gap: 6px; }
.rowTop { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
.empty {
  padding: var(--s-8) var(--s-6);
  color: var(--text-soft);
  border-style: dashed;
  text-align: center;
  display: grid;
  gap: var(--s-2);
  justify-items: center;
  line-height: 1.6;
}
.empty::before {
  content: '✦';
  font-size: 1.3rem;
  color: var(--accent);
  opacity: 0.65;
}

.card strong,
.row strong,
.formCard strong { color: #fff4e7; }

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-thumb { background: rgba(212, 168, 60, 0.26); border-radius: var(--radius-pill); }
::-webkit-scrollbar-track { background: rgba(255,255,255,0.03); }

@media (max-width: 1180px) {
  .heroSurface,
  .splitSection,
  .tripleGrid,
  .recentGrid,
  .flowRail { grid-template-columns: 1fr; }
}

@media (max-width: 980px) {
  .shell { grid-template-columns: 1fr; }
  .sidebar {
    position: relative;
    height: auto;
    border-right: 0;
    border-bottom: 1px solid rgba(212, 168, 60, 0.12);
  }
  .content { padding: 20px 16px 44px; }
  .heroHeader,
  .heroSurface,
  .card,
  .formCard,
  .featurePanel,
  .row,
  .metricCard,
  .heroMetricCard { padding: 18px; }
}

@media (max-width: 640px) {
  .brand { font-size: 2rem; }
  .pageTitle { font-size: 2rem; }
  .heroTitle { font-size: 2.35rem; }
  .sectionHeaderInline { align-items: start; flex-direction: column; }
  .navLink { min-height: 44px; }
  .primaryButton,
  .primaryLink,
  .secondaryLink { width: 100%; }
}

/* a11y: foco de teclado visivel */
:where(a, button, input, select, textarea, summary):focus-visible {
  outline: 2px solid var(--accent-hi);
  outline-offset: 2px;
}
.navLink:focus-visible { border-color: var(--accent-hi); }

/* nav recolhivel no mobile (design-review) */
.navToggle { display: none; }
@media (max-width: 980px) {
  .navToggle {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    width: 100%; min-height: 46px; padding: 0 var(--s-4);
    border-radius: var(--radius-sm); border: 1px solid var(--line-strong);
    background: rgba(255,255,255,0.04); color: #f0e7dd;
    font-weight: 700; letter-spacing: 0.04em; cursor: pointer;
  }
  .navToggleHint { font-size: var(--fs-xs); color: var(--muted); text-transform: uppercase; letter-spacing: 0.14em; }
  .nav.navCollapsed { display: none; }
}


/* Motion Videos · Higgsfield Studio */
.cardLike {
  border: 1px solid var(--line);
  border-radius: var(--radius-xl);
  background: linear-gradient(145deg, rgba(255,255,255,.055), rgba(255,255,255,.02));
  box-shadow: var(--shadow);
}
.motionHero { grid-template-columns: minmax(0, 1fr) 320px; align-items: end; }
.motionHeroPanel,.formatInsight,.errorBox { border: 1px solid var(--line); border-radius: var(--radius-lg); background: rgba(255,255,255,.045); padding: 18px; }
.motionHeroPanel { display: grid; gap: 10px; }
.errorBox { border-color: rgba(255,141,135,.45); color: var(--danger); }
.motionFlow { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; padding: 16px; }
.motionFlowStep { display: grid; gap: 6px; padding: 14px; border-radius: var(--radius-md); background: rgba(0,0,0,.18); }
.motionFlowStep span { color: var(--accent-mid); font-size: .72rem; letter-spacing: .14em; }
.motionFlowStep strong { font-size: .86rem; line-height: 1.35; }
.motionGrid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr); gap: var(--s-6); align-items: start; }
.motionForm label { display: grid; gap: 8px; color: #f2e8d9; font-weight: 700; }
.motionForm textarea,.motionForm select { width: 100%; border: 1px solid rgba(212,168,60,.22); border-radius: var(--radius-md); background: rgba(0,0,0,.22); color: var(--text); padding: 13px 14px; outline: none; }
.motionForm textarea:focus,.motionForm select:focus { border-color: rgba(255,241,168,.62); box-shadow: 0 0 0 3px rgba(212,168,60,.12); }
.twoCols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4); }
.formatInsight { display: grid; gap: 6px; }
.formatInsight p, .formatInsight small { margin: 0; color: var(--text-soft); line-height: 1.55; }
.motionPreview { position: sticky; top: 28px; padding: 24px; display: grid; gap: 14px; }
.motionEmptyRatio { min-height: 340px; border-radius: 26px; display: grid; place-items: center; border: 1px dashed rgba(212,168,60,.28); color: rgba(255,241,168,.72); background: radial-gradient(circle at 50% 20%, rgba(212,168,60,.14), transparent 46%), rgba(0,0,0,.16); }
.scoreGrid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 8px; }
.scoreCard { padding: 10px; border-radius: 14px; background: rgba(0,0,0,.18); border: 1px solid rgba(255,255,255,.06); }
.scoreCard span { display:block; color: var(--muted); font-size: .72rem; }
.scoreCard strong { color: var(--accent-hi); font-size: 1.2rem; }
.motionMeta { display:flex; flex-wrap:wrap; gap:8px; }
.motionMeta span { border:1px solid var(--line); border-radius:999px; padding:6px 10px; color:#f8e8c2; background:rgba(212,168,60,.08); font-size:.76rem; }
.motionBlocks { display:grid; gap: var(--s-4); }
.motionBlock { padding: 22px; display:grid; gap: 10px; }
.motionBlock h4 { margin: 0; color:#f7efe5; font-size:1.02rem; line-height:1.55; }
.motionBlock p { margin:0; color:var(--text-soft); line-height:1.55; }
.motionBlock details { border-top:1px solid var(--line); padding-top:12px; }
.motionBlock summary { cursor:pointer; color: var(--accent-hi); font-weight:700; }
.motionBlock pre { white-space: pre-wrap; word-break: break-word; background: rgba(0,0,0,.28); border-radius:16px; padding:16px; overflow:auto; }
@media (max-width: 1100px) { .motionHero,.motionGrid { grid-template-columns: 1fr; } .motionPreview { position: relative; top: auto; } }
@media (max-width: 720px) { .twoCols,.scoreGrid { grid-template-columns: 1fr; } .motionFlow { grid-template-columns: 1fr; } }

/* Motion Videos Fase 2 · exemplos, matriz e winners */
.examplesRail,
.winnerStack {
  display: grid;
  gap: 10px;
}
.sectionHeaderCompact {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
}
.exampleCard,
.winnerCard,
.matrixMini {
  border: 1px solid rgba(212,168,60,.18);
  border-radius: 16px;
  background: rgba(0,0,0,.18);
  padding: 14px;
  display: grid;
  gap: 7px;
}
.exampleCard span,
.winnerCard span {
  width: fit-content;
  border: 1px solid rgba(255,241,168,.18);
  border-radius: 999px;
  padding: 4px 8px;
  color: var(--accent-hi);
  font-size: .68rem;
  letter-spacing: .12em;
  text-transform: uppercase;
}
.exampleCard strong,
.winnerCard strong,
.matrixMini strong { color: #fff4e7; }
.exampleCard p,
.exampleCard small,
.winnerCard p,
.matrixMini p { margin: 0; color: var(--text-soft); line-height: 1.52; }

/* Motion Videos Fase 3 · referências reais governadas */
.realExampleBox {
  border: 1px solid rgba(74, 222, 128, .2);
  border-radius: 18px;
  background: linear-gradient(145deg, rgba(20,83,45,.16), rgba(0,0,0,.16));
  padding: 16px;
  display: grid;
  gap: 10px;
}
.realExampleBox input,
.realExampleBox textarea {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: rgba(255,255,255,.045);
  color: var(--text);
  padding: 10px 12px;
}
.secondaryButton {
  border: 1px solid rgba(212,168,60,.35);
  border-radius: 999px;
  background: rgba(212,168,60,.12);
  color: #fff3d6;
  padding: 10px 14px;
  font-weight: 800;
  cursor: pointer;
}
.secondaryButton:disabled { opacity: .6; cursor: not-allowed; }

/* Motion Videos Fase 4 · coleta temática */
.themeCollectBox {
  border: 1px solid rgba(59, 130, 246, .24);
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(15, 23, 42, .72), rgba(30, 58, 138, .18));
  padding: 18px;
  display: grid;
  gap: 12px;
}
.themeCollectBox input,
.themeCollectBox textarea {
  width: 100%;
}

/* Motion Videos Fase 5 · winners reais */
.themeWinnersGrid {
  display: grid;
  gap: 12px;
  margin-top: 6px;
}
.themeWinnerCard {
  border: 1px solid rgba(245, 158, 11, .24);
  border-radius: 14px;
  padding: 12px;
  background: rgba(15, 23, 42, .58);
}
.themeWinnerCard span {
  display: inline-flex;
  width: fit-content;
  border-radius: 999px;
  padding: 3px 8px;
  background: rgba(245, 158, 11, .15);
  color: #fcd34d;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .08em;
}
.themeWinnerCard ul {
  margin: 8px 0;
  padding-left: 18px;
}
.winnerPlanButton {
  margin-top: 10px;
  border: 1px solid rgba(252, 211, 77, .35);
  background: rgba(245, 158, 11, .12);
  color: #fde68a;
  border-radius: 999px;
  padding: 8px 12px;
  cursor: pointer;
  font-weight: 700;
}
.winnerPlanButton:disabled {
  opacity: .55;
  cursor: wait;
}

/* ————— Design system compartilhado (padrão /trafego) —————
   Usa os tokens --state-good/--state-warn/--state-bad/--state-neutral.
   Consumido pelos primitivos em app/components/ui/ e pelas páginas novas. */

/* pill chapada colorida (como o Chip da /trafego) — pinte com background */
.stateChip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border-radius: var(--radius-pill);
  padding: 3px 12px;
  color: #fff;
  font-size: .75rem;
  font-weight: 700;
  white-space: nowrap;
  background: var(--state-neutral);
}

/* card de ação (fila da /trafego): featurePanel + borda esquerda colorida.
   Uso: <article class="featurePanel cardAcao" style={{ '--cor': ... }}> */
.cardAcao {
  border-left: 4px solid var(--cor, var(--state-neutral));
  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
}
a.cardAcao { display: grid; color: inherit; }
a.cardAcao:hover {
  transform: translateY(-1px);
  border-color: var(--line-strong);
  border-left-color: var(--cor, var(--state-neutral));
  box-shadow: 0 12px 30px rgba(0, 0, 0, .24);
}

/* KPI centrado com borda colorida + glow interno (Kpi da /trafego).
   Uso: <article class="kpiTile" style={{ '--cor': ... }}> */
.kpiTile {
  display: grid;
  gap: 4px;
  justify-items: center;
  text-align: center;
  padding: 14px 16px;
  border-radius: 14px;
  background: rgba(255, 255, 255, .04);
  border: 1px solid color-mix(in srgb, var(--cor, var(--line-strong)) 40%, transparent);
  box-shadow: inset 0 0 24px color-mix(in srgb, var(--cor, transparent) 8%, transparent);
}
.kpiTile .kpiRotulo {
  margin: 0;
  font-size: .7rem;
  text-transform: uppercase;
  letter-spacing: .08em;
  opacity: .6;
}
.kpiTile .kpiValor {
  margin: 0;
  font-weight: 800;
  font-size: 1.45rem;
  color: var(--cor, inherit);
}

/* Content Radar v1 · evidência observada + governança de fontes */
.radarRoot { gap: var(--s-7); }
.radarHero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--s-6);
  background:
    radial-gradient(circle at 14% 0%, rgba(255, 241, 168, .14), transparent 30%),
    linear-gradient(132deg, rgba(38, 28, 18, .94), rgba(12, 10, 7, .98));
}
.radarHeroCopy { display: grid; gap: var(--s-3); }
.radarStatusLine {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  width: fit-content;
  color: var(--text-soft);
  font-size: .76rem;
  font-weight: 700;
  letter-spacing: .04em;
}
.radarLiveDot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--state-neutral);
  box-shadow: 0 0 0 5px rgba(111, 106, 97, .12);
}
.radarLiveDot.isOn {
  background: var(--state-good);
  box-shadow: 0 0 0 5px rgba(47, 158, 99, .12);
}
.radarMetrics .metricCard { min-height: 158px; align-content: start; gap: 7px; }
.radarMetrics .metricCard p { margin: auto 0 0; }
.radarMetricPrimary {
  border-color: rgba(255, 241, 168, .32);
  background:
    radial-gradient(circle at 90% 0%, rgba(255, 241, 168, .12), transparent 42%),
    var(--surface-strong);
}
.radarAlert {
  display: grid;
  gap: 6px;
  padding: 18px 20px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--line-strong);
  background: rgba(255, 255, 255, .035);
}
.radarAlertError { border-color: rgba(255, 141, 135, .42); color: #ffd1cd; }
.radarAlert span { color: var(--text-soft); }

.radarMethod {
  display: grid;
  gap: var(--s-6);
  padding: 30px;
  border: 1px solid var(--line);
  border-radius: var(--radius-xl);
  background:
    linear-gradient(150deg, rgba(31, 23, 15, .88), rgba(17, 13, 9, .94));
  box-shadow: var(--shadow);
}
.radarMethodSteps {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1px;
  margin: 0;
  padding: 0;
  list-style: none;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--line);
}
.radarMethodSteps li {
  display: grid;
  align-content: start;
  gap: 8px;
  min-height: 180px;
  padding: 20px;
  background: rgba(15, 12, 8, .94);
}
.radarMethodSteps li > span {
  color: var(--accent-mid);
  font-size: .72rem;
  letter-spacing: .18em;
  font-weight: 800;
}
.radarMethodSteps strong { color: #fff5e8; line-height: 1.35; }
.radarMethodSteps small { color: var(--text-soft); line-height: 1.55; }
.radarTimestamp { margin: 0; color: var(--text-soft); font-size: .82rem; }
.radarTimestamp strong { color: #f7ecdd; }

.radarEligibleSection {
  padding: 26px;
  border-radius: var(--radius-xl);
  border: 1px solid rgba(255, 241, 168, .22);
  background: rgba(255, 241, 168, .035);
}
.radarEligibleGrid,
.radarEvidenceGrid,
.radarSourceGrid {
  display: grid;
  gap: var(--s-4);
}
.radarEligibleGrid { grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); }
.radarEvidenceGrid { grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); }
.radarSourceGrid { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }

.radarToolbarHeader { margin-bottom: 2px; }
.radarToolbar {
  position: sticky;
  top: 14px;
  z-index: 5;
  display: grid;
  grid-template-columns: minmax(240px, 1.4fr) minmax(180px, .8fr) minmax(180px, .8fr) auto auto;
  align-items: end;
  gap: 10px;
  padding: 14px;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-lg);
  background: rgba(18, 14, 9, .92);
  box-shadow: 0 18px 42px rgba(0, 0, 0, .28);
  backdrop-filter: blur(18px);
}
.radarToolbar label { display: grid; gap: 6px; }
.radarToolbar label > span {
  color: var(--text-soft);
  font-size: .7rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  font-weight: 700;
}
.radarToolbar .input { min-height: 46px; padding: 10px 13px; }
.radarToolbar .secondaryButton,
.radarToolbar .secondaryLink { min-height: 46px; white-space: nowrap; }

.radarEvidenceCard {
  --signal-color: var(--state-neutral);
  display: grid;
  align-content: start;
  gap: var(--s-4);
  min-width: 0;
  padding: 22px;
  border: 1px solid var(--line);
  border-top: 3px solid var(--signal-color);
  border-radius: var(--radius-lg);
  background:
    linear-gradient(180deg, color-mix(in srgb, var(--signal-color) 7%, transparent), transparent 36%),
    var(--surface);
  box-shadow: var(--shadow);
}
.radarSignalBreakout { --signal-color: #e6bd48; }
.radarSignalOutlier { --signal-color: #d69b43; }
.radarSignalEarly { --signal-color: #7fa7c9; }
.radarSignalNormal { --signal-color: var(--state-good); }
.radarSignalInsufficient { --signal-color: var(--state-neutral); }
.radarEvidenceCard h4 {
  margin: 4px 0 0;
  color: #fff5e8;
  font-family: var(--font-display), Georgia, serif;
  font-size: 1.55rem;
  letter-spacing: -.02em;
  overflow-wrap: anywhere;
}
.radarEvidenceCard p { margin: 0; }
.radarCardTop {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--s-3);
}
.radarPillRow { display: flex; gap: 7px; flex-wrap: wrap; }
.radarEvidenceCard .stateChip { background: var(--signal-color); color: #17120c; }
.radarSignalLabel {
  color: var(--signal-color);
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
  white-space: nowrap;
}
.radarCaption { color: var(--text-soft); line-height: 1.62; }
.radarUnknown { display: block; margin-top: 5px; color: var(--state-warn); }
.radarEvidenceStrip {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 6px 12px;
  padding: 13px 14px;
  border: 1px solid color-mix(in srgb, var(--signal-color) 30%, transparent);
  border-radius: var(--radius-md);
  background: rgba(0, 0, 0, .18);
  color: var(--text-soft);
  font-size: .78rem;
}
.radarEvidenceStrip strong { color: #fff5e8; text-align: right; }
.radarEvidenceDefinition {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  margin: 0;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--line);
}
.radarEvidenceDefinition div { min-width: 0; padding: 12px; background: rgba(10, 8, 6, .72); }
.radarEvidenceDefinition dt {
  color: var(--muted);
  font-size: .66rem;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.radarEvidenceDefinition dd { margin: 4px 0 0; color: #f8eee3; font-weight: 700; overflow-wrap: anywhere; }
.radarReason {
  padding: 12px 14px;
  border-left: 3px solid var(--state-neutral);
  background: rgba(255, 255, 255, .025);
  color: var(--text-soft);
  line-height: 1.5;
  font-size: .8rem;
}
.radarDetails {
  padding: 13px 14px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: rgba(0, 0, 0, .14);
}
.radarDetails summary { cursor: pointer; color: #f3e8d9; font-weight: 700; }
.radarDetails p { margin: 12px 0 0; color: var(--muted); font-size: .8rem; }
.radarDetails ul { display: grid; gap: 7px; margin: 12px 0 0; padding: 0; list-style: none; }
.radarDetails li { display: flex; justify-content: space-between; gap: 12px; color: var(--text-soft); font-size: .78rem; }
.radarDetails li a { color: var(--accent-mid); text-decoration: underline; text-underline-offset: 3px; }
.radarHypothesis {
  display: grid;
  gap: 8px;
  padding: 14px;
  border-radius: var(--radius-md);
  border: 1px dashed rgba(212, 168, 60, .24);
  background: rgba(212, 168, 60, .04);
}
.radarHypothesis > span { color: var(--accent-mid); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; font-weight: 800; }
.radarHypothesis p { color: var(--text-soft); font-size: .8rem; line-height: 1.55; }
.radarCardActions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: auto; }
.radarDisabledAction {
  display: inline-flex;
  align-items: center;
  min-height: 46px;
  padding: 0 15px;
  border: 1px solid rgba(255, 255, 255, .08);
  border-radius: var(--radius-pill);
  color: var(--muted);
  font-size: .78rem;
  font-weight: 700;
  background: rgba(255, 255, 255, .025);
}
.radarPaginationGate {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
  padding: 18px;
  border: 1px dashed var(--line-strong);
  border-radius: var(--radius-lg);
  color: var(--text-soft);
  font-size: .82rem;
  text-align: center;
  background: rgba(255, 255, 255, .02);
}
.radarSourceCard {
  display: grid;
  align-content: start;
  gap: 9px;
  min-width: 0;
  min-height: 155px;
  padding: 18px;
  border: 1px solid var(--line);
  border-left: 3px solid var(--state-neutral);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, .025);
}
.radarSourceCard p,
.radarSourceCard strong,
.radarSourceCard span { overflow-wrap: anywhere; }
.radarSourceCard p { margin: 0; color: var(--text-soft); font-size: .78rem; line-height: 1.5; }
.radarSourceCard.source-approved,
.radarSourceCard.source-own_account { border-left-color: var(--state-good); }
.radarSourceCard.source-candidate { border-left-color: var(--state-warn); }
.radarSourceCard.source-excluded { border-left-color: var(--state-bad); opacity: .76; }
.radarSourceCard.source-thematic_search { border-left-color: #7fa7c9; }
.radarSourcesSection { padding-bottom: var(--s-4); }

@media (max-width: 1180px) {
  .radarMethodSteps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .radarToolbar { grid-template-columns: repeat(2, minmax(0, 1fr)); position: relative; top: auto; }
}
@media (max-width: 760px) {
  .radarHero { align-items: stretch; flex-direction: column; }
  .radarMethod { padding: 20px; }
  .radarMethodSteps,
  .radarToolbar,
  .radarEvidenceDefinition { grid-template-columns: 1fr; }
  .radarMethodSteps li { min-height: auto; }
  .radarEvidenceGrid,
  .radarEligibleGrid,
  .radarSourceGrid { grid-template-columns: minmax(0, 1fr); }
  .radarEligibleSection { padding: 18px; }
  .radarCardTop { align-items: flex-start; flex-direction: column; }
  .radarSignalLabel { white-space: normal; }
  .radarCardActions > *,
  .radarToolbar > * { width: 100%; }
}

/* Content Radar v1 · estados exclusivos, a11y e governança inline */
.radarRoot,
.radarRoot > *,
.radarHeroCopy,
.radarStatePanel { min-width: 0; }

.radarStateHero { align-items: center; }
.radarStatePanel {
  display: grid;
  justify-items: start;
  gap: var(--s-3);
  padding: clamp(22px, 4vw, 38px);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-xl);
  background: radial-gradient(circle at 95% 0%, rgba(255, 241, 168, .08), transparent 36%), var(--surface-strong);
  box-shadow: var(--shadow);
  color: #f4ece3;
}
.radarStatePanel > * { margin: 0; }
.radarStatePanel p { color: #c9c1b8; line-height: 1.65; }
.radarStateError { border-color: rgba(255, 141, 135, .58); }
.radarStateError > strong,
.radarStateError > p:first-of-type { color: #ffb3ae; }

.radarInlineEmpty {
  display: grid;
  justify-items: start;
  gap: var(--s-2);
  padding: var(--s-6);
  border: 1px dashed var(--line-strong);
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, .025);
  color: #c9c1b8;
  line-height: 1.6;
}
.radarInlineEmpty strong { color: #fff5e8; }
.radarInlineEmpty .secondaryLink { margin-top: var(--s-2); }
.radarSectionIntro { max-width: 72ch; margin: 7px 0 0; }
.radarCount { color: #c9c1b8; text-align: right; }

.radarActivity {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  flex: 0 0 auto;
  border-radius: var(--radius-pill);
  padding: 5px 9px;
  border: 1px solid rgba(255, 255, 255, .16);
  color: #e7e0d8;
  background: rgba(255, 255, 255, .06);
  font-size: .7rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .08em;
}
.radarActivity::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #aaa39a; }
.radarActivity.isActive { color: #baf4d3; border-color: rgba(127, 208, 165, .42); }
.radarActivity.isActive::before { background: #7fd0a5; }
.radarSourceCard.isInactive {
  opacity: 1;
  border-color: rgba(255, 255, 255, .13);
  background: rgba(255, 255, 255, .015);
}
.radarSourceCard.isInactive > :not(.radarCardTop) { color: #aaa39a; }

.radarGovernanceDetails { margin-top: var(--s-2); padding-top: var(--s-3); border-top: 1px solid var(--line); }
.radarGovernanceDetails summary {
  width: fit-content;
  cursor: pointer;
  color: #f7d86a;
  font-size: .82rem;
  font-weight: 800;
  text-decoration: underline;
  text-underline-offset: 4px;
}
.radarGovernanceForm { display: grid; gap: var(--s-3); margin-top: var(--s-4); }
.radarGovernanceForm label { display: grid; gap: 7px; }
.radarGovernanceForm label > span { color: #d4ccc3; font-size: .75rem; font-weight: 700; line-height: 1.45; }
.radarGovernanceForm .textarea { min-height: 96px; }
.radarGovernanceForm .secondaryButton { min-height: 46px; width: fit-content; }
.radarGovernanceFeedback {
  padding: 14px 16px;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-md);
  color: #eee6dd;
  line-height: 1.55;
}
.radarGovernanceFeedback.is-ok { border-color: rgba(127, 208, 165, .48); background: rgba(47, 158, 99, .12); color: #c8f5dc; }
.radarGovernanceFeedback.is-error { border-color: rgba(255, 141, 135, .5); background: rgba(192, 82, 77, .12); color: #ffc4c0; }

/* Cores usadas como texto mantêm contraste AA sobre as superfícies escuras. */
.radarSignalBreakout { --signal-color: #f3ce65; }
.radarSignalOutlier { --signal-color: #e8b563; }
.radarSignalEarly { --signal-color: #9bc9eb; }
.radarSignalNormal { --signal-color: #7fd0a5; }
.radarSignalInsufficient { --signal-color: #b4ada4; }

.radarSkeleton {
  display: block;
  min-height: 158px;
  overflow: hidden;
  background: linear-gradient(110deg, rgba(255,255,255,.035) 25%, rgba(255,241,168,.1) 45%, rgba(255,255,255,.035) 65%);
  background-size: 220% 100%;
  animation: radarSkeletonPulse 1.6s ease-in-out infinite;
}
.radarLoadingLine { color: #c9c1b8; line-height: 1.6; }
@keyframes radarSkeletonPulse { to { background-position-x: -220%; } }

@media (max-width: 640px) {
  .radarRoot { gap: var(--s-5); }
  .radarRoot .pageTitle { font-size: clamp(1.75rem, 10vw, 2.25rem); overflow-wrap: anywhere; }
  .radarHero,
  .radarMethod,
  .radarEligibleSection,
  .radarStatePanel { border-radius: var(--radius-lg); }
  .radarEvidenceCard,
  .radarSourceCard { padding: var(--s-4); }
  .radarInlineEmpty { padding: var(--s-5) var(--s-4); }
  .radarCount { text-align: left; }
  .radarGovernanceForm .secondaryButton,
  .radarStatePanel .primaryButton,
  .radarStatePanel .secondaryLink { width: 100%; }
  .radarDetails li { align-items: flex-start; flex-direction: column; overflow-wrap: anywhere; }
}

@media (prefers-reduced-motion: reduce) {
  .radarSkeleton { animation: none; }
}
