{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.institutovitalslim.com.br/hook-intelligence/v1/content-os-export.schema.json",
  "title": "Content OS Export",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0", "default": "1.0.0"},
    "workspace_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "hooks": {
      "type": "array",
      "items": {"$ref": "hook.schema.json"}
    }
  },
  "required": ["schema_version", "workspace_ref", "generated_at", "hooks"]
}
