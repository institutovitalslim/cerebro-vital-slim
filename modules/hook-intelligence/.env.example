# Portas externas da stack isolada.
# 18080 permanece reservada ao Evolution no host IVS.
HOOK_API_PORT=18082
HOOK_WEB_PORT=13000

# Persistência. Em Docker, mantenha o arquivo no volume /data.
HOOK_DATABASE_URL=sqlite:////data/hooks.db

# Destino server-side do proxy Next.js no Compose.
HOOK_API_URL=http://backend:8000
PLAYWRIGHT_BASE_URL=http://127.0.0.1:13000

# IA é opt-in. false/0/no/off (ou ausente) não exige as demais variáveis.
HOOK_AI_ENABLED=false
# Endpoint OpenAI-compatible; padrão: https://api.openai.com/v1/chat/completions
HOOK_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# Nunca versionar valores reais.
HOOK_AI_API_KEY=
HOOK_AI_MODEL=
HOOK_AI_TIMEOUT_SECONDS=20
# Limite defensivo aceito: 1..4096
HOOK_AI_MAX_TOKENS=2048
